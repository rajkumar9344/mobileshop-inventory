{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "anayarojo/shoppingcart": "^4.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "cweagans/composer-patches": "^1.7",
        "doctrine/dbal": "^3.10",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^12.0",
        "nwidart/laravel-modules": "^10.0",
        "realrashid/sweet-alert": "^6.0",
        "spatie/laravel-medialibrary": "^10.0",
        "spatie/laravel-permission": "^5.0",
        "yajra/laravel-datatables": "^10.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/StatusHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "anayarojo/shoppingcart": {
                "Fix generateRowId to use _uid for stable row IDs on cart()->update()": "patches/cartitem-uid-rowid.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": {
                "CVE-2026-48019": "CRLF injection in default email rule is only fixed in Laravel 12.60+/13.10+; no Laravel 10.x patch exists. Mitigated app-side by enforcing email:rfc,strict validation everywhere."
            }
        },
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
